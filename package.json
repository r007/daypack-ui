{
  "name": "daypack-ui",
  "version": "0.1.0",
  "description": "Accessible React + TypeScript component library with Griffel styling and CSS-variable theming. ~90 components, native-first, light on dependencies.",
  "license": "MIT",
  "author": "r007 (https://github.com/r007)",
  "homepage": "https://r007.github.io/daypack-ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r007/daypack-ui.git"
  },
  "bugs": {
    "url": "https://github.com/r007/daypack-ui/issues"
  },
  "keywords": [
    "react",
    "react-components",
    "component-library",
    "ui-library",
    "design-system",
    "typescript",
    "griffel",
    "css-in-js",
    "css-variables",
    "theming",
    "accessibility",
    "a11y",
    "storybook"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build",
    "build:storybook": "storybook build -o storybook-static",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@griffel/react": "^1.7.8",
    "@griffel/sort-css-queries": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "leaflet": "1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@9.0.6",
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    }
  }
}
